{
  "name": "termi",
  "version": "1.10.0",
  "description": "Điều khiển Claude Code, tmux và git trên Mac mini từ điện thoại",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node src/server.mjs",
    "test": "node --test",
    "check": "node scripts/check.mjs",
    "verify": "npm run check && npm test",
    "service:install": "scripts/install.sh",
    "service:uninstall": "scripts/install.sh uninstall",
    "claude-usage": "node scripts/claude-statusline.mjs install",
    "claude-usage:off": "node scripts/claude-statusline.mjs uninstall",
    "release:asset": "npm pack && gh release upload v$npm_package_version termi-$npm_package_version.tgz --clobber && rm termi-$npm_package_version.tgz"
  },
  "engines": {
    "node": ">=24"
  },
  "files": [
    "src/",
    "public/",
    "scripts/",
    "README.md"
  ]
}
